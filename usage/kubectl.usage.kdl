            choices "json" "yaml" "name" "go-template" "go-template-file" "template" "templatefile" "jsonpath" "jsonpath-as-json" "jsonpath-file"
        }
        flag "-R --recursive" help="Process the directory used in -f, --filename recursively. Useful when you want to manage related manifests organized within the same directory."
        flag "-l --selector <value>" help="Selector (label query) to filter on, not including uninitialized ones, supports '=', '==', and '!='.(e.g. -l key1=value1,key2=value2)"
        flag "--serviceaccount <value>" help="Service accounts to bind to the role" var=#true
        flag "--template <value>" help="Template string or path to template file to use when -o=go-template, -o=go-template-file. The template format is golang templates [http://golang.org/pkg/text/template/#pkg-overview]."
    }
}
cmd "taint" help="Update the taints on one or more nodes" {
    // Source: "kubectl-taint.1"
    arg "[args]..."
    flag "--all" help="Select all nodes in the cluster"
    flag "--allow-missing-template-keys" help="If true, ignore any errors in templates when a field or map key is missing in the template. Only applies to golang and jsonpath output formats."
    flag "--dry-run <value>" help="Must be \"none\", \"server\", or \"client\". If client strategy, only print the object that would be sent, without sending it. If server strategy, submit server-side request without persisting the resource." {
        choices "none" "server" "client"
    }
    flag "--field-manager <value>" help="Name of the manager used to track field ownership."
    flag "-o --output <value>" help="Output format. One of: json|yaml|name|go-template|go-template-file|template|templatefile|jsonpath|jsonpath-as-json|jsonpath-file." {
        choices "json" "yaml" "name" "go-template" "go-template-file" "template" "templatefile" "jsonpath" "jsonpath-as-json" "jsonpath-file"
    }
    flag "--overwrite" help="If true, allow taints to be overwritten, otherwise reject taint updates that overwrite existing taints."
    flag "-l --selector <value>" help="Selector (label query) to filter on, supports '=', '==', and '!='.(e.g. -l key1=value1,key2=value2)"
    flag "--template <value>" help="Template string or path to template file to use when -o=go-template, -o=go-template-file. The template format is golang templates [http://golang.org/pkg/text/template/#pkg-overview]."
    flag "--validate" help="If true, use a schema to validate the input before sending it"
}
cmd "top" help="Display Resource (CPU/Memory/Storage) usage." {
    // Source: "kubectl-top.1"
    arg "[args]..."
    cmd "node" help="Display Resource (CPU/Memory/Storage) usage of nodes" {
        // Source: "kubectl-top-node.1"
        arg "[args]..."
        flag "--heapster-namespace <value>" help="Namespace Heapster service is located in"
        flag "--heapster-port <value>" help="Port name in service to use"
        flag "--heapster-scheme <value>" help="Scheme (http or https) to connect to Heapster as"
        flag "--heapster-service <value>" help="Name of Heapster service"
        flag "--no-headers" help="If present, print output without headers"
        flag "-l --selector <value>" help="Selector (label query) to filter on, supports '=', '==', and '!='.(e.g. -l key1=value1,key2=value2)"
        flag "--sort-by <value>" help="If non-empty, sort nodes list using specified field. The field can be either 'cpu' or 'memory'."
    }
    cmd "pod" help="Display Resource (CPU/Memory/Storage) usage of pods" {
        // Source: "kubectl-top-pod.1"
        arg "[args]..."
        flag "-A --all-namespaces" help="If present, list the requested object(s) across all namespaces. Namespace in current context is ignored even if specified with --namespace."
        flag "--containers" help="If present, print usage of containers within a pod."
        flag "--no-headers" help="If present, print output without headers."
        flag "-l --selector <value>" help="Selector (label query) to filter on, supports '=', '==', and '!='.(e.g. -l key1=value1,key2=value2)"
        flag "--sort-by <value>" help="If non-empty, sort pods list using specified field. The field can be either 'cpu' or 'memory'."
    }
}
cmd "uncordon" help="Mark node as schedulable" {
    // Source: "kubectl-uncordon.1"
    arg "[args]..."
    flag "--dry-run <value>" help="Must be \"none\", \"server\", or \"client\". If client strategy, only print the object that would be sent, without sending it. If server strategy, submit server-side request without persisting the resource." {
        choices "none" "server" "client"
    }
    flag "-l --selector <value>" help="Selector (label query) to filter on"
}
cmd "version" help="Print the client and server version information" {
    // Source: "kubectl-version.1"
    arg "[args]..."
    flag "--client" help="If true, shows client version only (no server required)."
    flag "-o --output <value>" help="One of 'yaml' or 'json'."
    flag "--short" help="If true, print just the version number."
}
cmd "wait" help="Experimental: Wait for a specific condition on one or many resources." {
    // Source: "kubectl-wait.1"
    arg "[args]..."
    flag "--all" help="Select all resources in the namespace of the specified resource types"
    flag "-A --all-namespaces" help="If present, list the requested object(s) across all namespaces. Namespace in current context is ignored even if specified with --namespace."
    flag "--allow-missing-template-keys" help="If true, ignore any errors in templates when a field or map key is missing in the template. Only applies to golang and jsonpath output formats."
    flag "--field-selector <value>" help="Selector (field query) to filter on, supports '=', '==', and '!='.(e.g. --field-selector key1=value1,key2=value2). The server only supports a limited number of field queries per type."
    flag "-f --filename <value>" help="identifying the resource." var=#true
    flag "--for <value>" help="The condition to wait on: [delete|condition=condition-name]."
    flag "--local" help="If true, annotation will NOT contact api-server but run locally."
    flag "-o --output <value>" help="Output format. One of: json|yaml|name|go-template|go-template-file|template|templatefile|jsonpath|jsonpath-as-json|jsonpath-file." {
        choices "json" "yaml" "name" "go-template" "go-template-file" "template" "templatefile" "jsonpath" "jsonpath-as-json" "jsonpath-file"
    }
    flag "-R --recursive" help="Process the directory used in -f, --filename recursively. Useful when you want to manage related manifests organized within the same directory."
    flag "-l --selector <value>" help="Selector (label query) to filter on, supports '=', '==', and '!='.(e.g. -l key1=value1,key2=value2)"
    flag "--template <value>" help="Template string or path to template file to use when -o=go-template, -o=go-template-file. The template format is golang templates [http://golang.org/pkg/text/template/#pkg-overview]."
    flag "--timeout <value>" help="The length of time to wait before giving up.  Zero means check once and don't wait, negative means wait for a week."
}
