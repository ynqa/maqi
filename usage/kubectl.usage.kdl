cmd "debug" help="Create debugging sessions for troubleshooting workloads and nodes" {
    // Source: "kubectl-debug.1"
    arg "[args]..."
    flag "--arguments-only" help="If specified, everything after -- will be passed to the new container as Args instead of Command."
    flag "--attach" help="If true, wait for the container to start running, and then attach as if 'kubectl attach ...' were called.  Default false, unless '-i/--stdin' is set, in which case the default is true."
    flag "-c --container <value>" help="Container name to use for debug container."
    flag "--copy-to <value>" help="Create a copy of the target Pod with this name."
    flag "--env <value>" help="Environment variables to set in the container." var=#true
    flag "--image <value>" help="Container image to use for debug container."
    flag "--image-pull-policy <value>" help="The image pull policy for the container. If left empty, this value will not be specified by the client and defaulted by the server."
    flag "--quiet" help="If true, suppress informational messages."
    flag "--replace" help="When used with '--copy-to', delete the original Pod."
    flag "--same-node" help="When used with '--copy-to', schedule the copy of target Pod on the same node."
    flag "--set-image <value>" help="When used with '--copy-to', a list of name=image pairs for changing container images, similar to how 'kubectl set image' works." var=#true
    flag "--share-processes" help="When used with '--copy-to', enable process namespace sharing in the copy."
    flag "-i --stdin" help="Keep stdin open on the container(s) in the pod, even if nothing is attached."
    flag "--target <value>" help="When using an ephemeral container, target processes in this container name."
    flag "-t --tty" help="Allocate a TTY for the debugging container."
}
cmd "delete" help="Delete resources by filenames, stdin, resources and names, or by resources and label selector" {
    // Source: "kubectl-delete.1"
    arg "[args]..."
    flag "--all" help="Delete all resources, including uninitialized ones, in the namespace of the specified resource types."
    flag "-A --all-namespaces" help="If present, list the requested object(s) across all namespaces. Namespace in current context is ignored even if specified with --namespace."
    flag "--cascade <value>" help="Must be \"background\", \"orphan\", or \"foreground\". Selects the deletion cascading strategy for the dependents (e.g. Pods created by a ReplicationController). Defaults to background." {
        choices "background" "orphan" "foreground"
    }
    flag "--dry-run <value>" help="Must be \"none\", \"server\", or \"client\". If client strategy, only print the object that would be sent, without sending it. If server strategy, submit server-side request without persisting the resource." {
        choices "none" "server" "client"
    }
    flag "--field-selector <value>" help="Selector (field query) to filter on, supports '=', '==', and '!='.(e.g. --field-selector key1=value1,key2=value2). The server only supports a limited number of field queries per type."
    flag "-f --filename <value>" help="containing the resource to delete." var=#true
    flag "--force" help="If true, immediately remove resources from API and bypass graceful deletion. Note that immediate deletion of some resources may result in inconsistency or data loss and requires confirmation."
    flag "--grace-period <value>" help="Period of time in seconds given to the resource to terminate gracefully. Ignored if negative. Set to 1 for immediate shutdown. Can only be set to 0 when --force is true (force deletion)."
    flag "--ignore-not-found" help="Treat \"resource not found\" as a successful delete. Defaults to \"true\" when --all is specified."
    flag "-k --kustomize <value>" help="Process a kustomization directory. This flag can't be used together with -f or -R."
    flag "--now" help="If true, resources are signaled for immediate shutdown (same as --grace-period=1)."
    flag "-o --output <value>" help="Output mode. Use \"-o name\" for shorter output (resource/name)."
    flag "--raw <value>" help="Raw URI to DELETE to the server.  Uses the transport specified by the kubeconfig file."
    flag "-R --recursive" help="Process the directory used in -f, --filename recursively. Useful when you want to manage related manifests organized within the same directory."
    flag "-l --selector <value>" help="Selector (label query) to filter on, not including uninitialized ones."
    flag "--timeout <value>" help="The length of time to wait before giving up on a delete, zero means determine a timeout from the size of the object"
    flag "--wait" help="If true, wait for resources to be gone before returning. This waits for finalizers."
}
cmd "describe" help="Show details of a specific resource or group of resources" {
    // Source: "kubectl-describe.1"
    arg "[args]..."
    flag "-A --all-namespaces" help="If present, list the requested object(s) across all namespaces. Namespace in current context is ignored even if specified with --namespace."
    flag "-f --filename <value>" help="Filename, directory, or URL to files containing the resource to describe" var=#true
    flag "-k --kustomize <value>" help="Process the kustomization directory. This flag can't be used together with -f or -R."
    flag "-R --recursive" help="Process the directory used in -f, --filename recursively. Useful when you want to manage related manifests organized within the same directory."
    flag "-l --selector <value>" help="Selector (label query) to filter on, supports '=', '==', and '!='.(e.g. -l key1=value1,key2=value2)"
    flag "--show-events" help="If true, display events related to the described object."
}
cmd "diff" help="Diff live version against would-be applied version" {
