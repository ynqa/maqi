    flag "-k --kustomize <value>" help="Process the kustomization directory. This flag can't be used together with -f or -R."
    flag "-R --recursive" help="Process the directory used in -f, --filename recursively. Useful when you want to manage related manifests organized within the same directory."
    flag "-l --selector <value>" help="Selector (label query) to filter on, supports '=', '==', and '!='.(e.g. -l key1=value1,key2=value2)"
    flag "--server-side" help="If true, apply runs in the server instead of the client."
}
cmd "drain" help="Drain node in preparation for maintenance" {
    // Source: "kubectl-drain.1"
    arg "[args]..."
    flag "--delete-emptydir-data" help="Continue even if there are pods using emptyDir (local data that will be deleted when the node is drained)."
    flag "--delete-local-data" help="Continue even if there are pods using emptyDir (local data that will be deleted when the node is drained)."
    flag "--disable-eviction" help="Force drain to use delete, even if eviction is supported. This will bypass checking PodDisruptionBudgets, use with caution."
    flag "--dry-run <value>" help="Must be \"none\", \"server\", or \"client\". If client strategy, only print the object that would be sent, without sending it. If server strategy, submit server-side request without persisting the resource." {
        choices "none" "server" "client"
    }
    flag "--force" help="Continue even if there are pods not managed by a ReplicationController, ReplicaSet, Job, DaemonSet or StatefulSet."
    flag "--grace-period <value>" help="Period of time in seconds given to each pod to terminate gracefully. If negative, the default value specified in the pod will be used."
    flag "--ignore-daemonsets" help="Ignore DaemonSet-managed pods."
    flag "--pod-selector <value>" help="Label selector to filter pods on the node"
    flag "-l --selector <value>" help="Selector (label query) to filter on"
    flag "--skip-wait-for-delete-timeout <value>" help="If pod DeletionTimestamp older than N seconds, skip waiting for the pod.  Seconds must be greater than 0 to skip."
    flag "--timeout <value>" help="The length of time to wait before giving up, zero means infinite"
}
cmd "edit" help="Edit a resource on the server" {
