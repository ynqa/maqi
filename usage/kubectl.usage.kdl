    }
    cmd "pause" help="Mark the provided resource as paused" {
        // Source: "kubectl-rollout-pause.1"
        arg "[args]..."
        flag "--allow-missing-template-keys" help="If true, ignore any errors in templates when a field or map key is missing in the template. Only applies to golang and jsonpath output formats."
        flag "--field-manager <value>" help="Name of the manager used to track field ownership."
