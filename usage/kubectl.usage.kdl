    flag "-R --recursive" help="Process the directory used in -f, --filename recursively. Useful when you want to manage related manifests organized within the same directory."
    flag "--save-config" help="If true, the configuration of current object will be saved in its annotation. Otherwise, the annotation will be unchanged. This flag is useful when you want to perform kubectl apply on this object in the future."
