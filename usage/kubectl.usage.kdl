cmd "proxy" help="Run a proxy to the Kubernetes API server" {
    // Source: "kubectl-proxy.1"
    arg "[args]..."
    flag "--accept-hosts <value>" help="Regular expression for hosts that the proxy should accept."
    flag "--accept-paths <value>" help="Regular expression for paths that the proxy should accept."
    flag "--address <value>" help="The IP address on which to serve on."
    flag "--api-prefix <value>" help="Prefix to serve the proxied API under."
    flag "--disable-filter" help="If true, disable request filtering in the proxy. This is dangerous, and can leave you vulnerable to XSRF attacks, when used with an accessible port."
    flag "--keepalive <value>" help="keepalive specifies the keep-alive period for an active network connection. Set to 0 to disable keepalive."
    flag "-p --port <value>" help="The port on which to run the proxy. Set to 0 to pick a random port."
    flag "--reject-methods <value>" help="Regular expression for HTTP methods that the proxy should reject (example --reject-methods='POST,PUT,PATCH')."
    flag "--reject-paths <value>" help="Regular expression for paths that the proxy should reject. Paths specified here will be rejected even accepted by --accept-paths."
    flag "-u --unix-socket <value>" help="Unix socket on which to run the proxy."
    flag "-w --www <value>" help="Also serve static files from the given directory under the specified prefix."
    flag "-P --www-prefix <value>" help="Prefix to serve static files under, if static file directory is specified."
}
