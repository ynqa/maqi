cmd "run" help="Run a particular image on the cluster" {
    // Source: "kubectl-run.1"
    arg "[args]..."
    flag "--allow-missing-template-keys" help="If true, ignore any errors in templates when a field or map key is missing in the template. Only applies to golang and jsonpath output formats."
    flag "--annotations <value>" help="Annotations to apply to the pod." var=#true
    flag "--attach" help="If true, wait for the Pod to start running, and then attach to the Pod as if 'kubectl attach ...' were called.  Default false, unless '-i/--stdin' is set, in which case the default is true. With '--restart=Never' the exit code of the container process is returned."
    flag "--cascade <value>" help="Must be \"background\", \"orphan\", or \"foreground\". Selects the deletion cascading strategy for the dependents (e.g. Pods created by a ReplicationController). Defaults to background." {
        choices "background" "orphan" "foreground"
    }
    flag "--command" help="If true and extra arguments are present, use them as the 'command' field in the container, rather than the 'args' field which is the default."
    flag "--dry-run <value>" help="Must be \"none\", \"server\", or \"client\". If client strategy, only print the object that would be sent, without sending it. If server strategy, submit server-side request without persisting the resource." {
        choices "none" "server" "client"
    }
    flag "--env <value>" help="Environment variables to set in the container." var=#true
    flag "--expose" help="If true, service is created for the container(s) which are run"
    flag "--field-manager <value>" help="Name of the manager used to track field ownership."
    flag "-f --filename <value>" help="to use to replace the resource." var=#true
    flag "--force" help="If true, immediately remove resources from API and bypass graceful deletion. Note that immediate deletion of some resources may result in inconsistency or data loss and requires confirmation."
    flag "--generator <value>" help="The name of the API generator to use, see http://kubernetes.io/docs/user-guide/kubectl-conventions/#generators for a list."
    flag "--grace-period <value>" help="Period of time in seconds given to the resource to terminate gracefully. Ignored if negative. Set to 1 for immediate shutdown. Can only be set to 0 when --force is true (force deletion)."
    flag "--hostport <value>" help="The host port mapping for the container port. To demonstrate a single-machine container."
    flag "--image <value>" help="The image for the container to run."
    flag "--image-pull-policy <value>" help="The image pull policy for the container. If left empty, this value will not be specified by the client and defaulted by the server"
    flag "-k --kustomize <value>" help="Process a kustomization directory. This flag can't be used together with -f or -R."
    flag "-l --labels <value>" help="Comma separated labels to apply to the pod(s). Will override previous values."
    flag "--leave-stdin-open" help="If the pod is started in interactive mode or with stdin, leave stdin open after the first attach completes. By default, stdin will be closed after the first attach completes."
    flag "--limits <value>" help="The resource requirement limits for this container.  For example, 'cpu=200m,memory=512Mi'.  Note that server side components may assign limits depending on the server configuration, such as limit ranges."
    flag "-o --output <value>" help="Output format. One of: json|yaml|name|go-template|go-template-file|template|templatefile|jsonpath|jsonpath-as-json|jsonpath-file." {
        choices "json" "yaml" "name" "go-template" "go-template-file" "template" "templatefile" "jsonpath" "jsonpath-as-json" "jsonpath-file"
    }
    flag "--overrides <value>" help="An inline JSON override for the generated object. If this is non-empty, it is used to override the generated object. Requires that the object supply a valid apiVersion field."
    flag "--pod-running-timeout <value>" help="The length of time (like 5s, 2m, or 3h, higher than zero) to wait until at least one pod is running"
    flag "--port <value>" help="The port that this container exposes."
    flag "--privileged" help="If true, run the container in privileged mode."
    flag "--quiet" help="If true, suppress prompt messages."
    flag "--record" help="Record current kubectl command in the resource annotation. If set to false, do not record the command. If set to true, record the command. If not set, default to updating the existing annotation value only if one already exists."
    flag "-R --recursive" help="Process the directory used in -f, --filename recursively. Useful when you want to manage related manifests organized within the same directory."
    flag "-r --replicas <value>" help="Number of replicas to create for this container. Default is 1."
    flag "--requests <value>" help="The resource requirement requests for this container.  For example, 'cpu=100m,memory=256Mi'.  Note that server side components may assign requests depending on the server configuration, such as limit ranges."
    flag "--restart <value>" help="The restart policy for this Pod.  Legal values [Always, OnFailure, Never]."
    flag "--rm" help="If true, delete resources created in this command for attached containers."
    flag "--save-config" help="If true, the configuration of current object will be saved in its annotation. Otherwise, the annotation will be unchanged. This flag is useful when you want to perform kubectl apply on this object in the future."
    flag "--schedule <value>" help="A schedule in the Cron format the job should be run with."
    flag "--service-generator <value>" help="The name of the generator to use for creating a service.  Only used if --expose is true"
    flag "--service-overrides <value>" help="An inline JSON override for the generated service object. If this is non-empty, it is used to override the generated object. Requires that the object supply a valid apiVersion field.  Only used if --expose is true."
    flag "--serviceaccount <value>" help="Service account to set in the pod spec."
    flag "-i --stdin" help="Keep stdin open on the container(s) in the pod, even if nothing is attached."
    flag "--template <value>" help="Template string or path to template file to use when -o=go-template, -o=go-template-file. The template format is golang templates [http://golang.org/pkg/text/template/#pkg-overview]."
    flag "--timeout <value>" help="The length of time to wait before giving up on a delete, zero means determine a timeout from the size of the object"
    flag "-t --tty" help="Allocated a TTY for each container in the pod."
    flag "--wait" help="If true, wait for resources to be gone before returning. This waits for finalizers."
}
cmd "scale" help="Set a new size for a Deployment, ReplicaSet or Replication Controller" {
    // Source: "kubectl-scale.1"
    arg "[args]..."
    flag "--all" help="Select all resources in the namespace of the specified resource types"
    flag "--allow-missing-template-keys" help="If true, ignore any errors in templates when a field or map key is missing in the template. Only applies to golang and jsonpath output formats."
    flag "--current-replicas <value>" help="Precondition for current size. Requires that the current size of the resource match this value in order to scale."
    flag "--dry-run <value>" help="Must be \"none\", \"server\", or \"client\". If client strategy, only print the object that would be sent, without sending it. If server strategy, submit server-side request without persisting the resource." {
        choices "none" "server" "client"
    }
    flag "-f --filename <value>" help="Filename, directory, or URL to files identifying the resource to set a new size" var=#true
    flag "-k --kustomize <value>" help="Process the kustomization directory. This flag can't be used together with -f or -R."
    flag "-o --output <value>" help="Output format. One of: json|yaml|name|go-template|go-template-file|template|templatefile|jsonpath|jsonpath-as-json|jsonpath-file." {
        choices "json" "yaml" "name" "go-template" "go-template-file" "template" "templatefile" "jsonpath" "jsonpath-as-json" "jsonpath-file"
    }
    flag "--record" help="Record current kubectl command in the resource annotation. If set to false, do not record the command. If set to true, record the command. If not set, default to updating the existing annotation value only if one already exists."
    flag "-R --recursive" help="Process the directory used in -f, --filename recursively. Useful when you want to manage related manifests organized within the same directory."
    flag "--replicas <value>" help="The new desired number of replicas. Required."
    flag "--resource-version <value>" help="Precondition for resource version. Requires that the current resource version match this value in order to scale."
    flag "-l --selector <value>" help="Selector (label query) to filter on, supports '=', '==', and '!='.(e.g. -l key1=value1,key2=value2)"
    flag "--template <value>" help="Template string or path to template file to use when -o=go-template, -o=go-template-file. The template format is golang templates [http://golang.org/pkg/text/template/#pkg-overview]."
    flag "--timeout <value>" help="The length of time to wait before giving up on a scale operation, zero means don't wait. Any other values should contain a corresponding time unit (e.g. 1s, 2m, 3h)."
}
